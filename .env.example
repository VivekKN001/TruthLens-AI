# Copy to .env (local) or add as Secrets/Variables on your host (deployed).
# Everything is optional: with nothing set, TruthLens uses local Ollama,
# a local SQLite history file, and no sign-in.

# ---------- Model ----------
# ollama (default, local) | gemini | groq | openai_compatible
LLM_PROVIDER=ollama
# Required for gemini/groq/openai_compatible.
#   Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys
LLM_API_KEY=
# Optional overrides of the provider preset (required for openai_compatible):
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_MAX_TOKENS=
# LLM_REASONING_EFFORT=low
# Only used with LLM_PROVIDER=ollama:
# OLLAMA_BASE_URL=http://localhost:11434

# ---------- History storage ----------
# Postgres URL (e.g. a free Neon database). Leave empty to use data/truthlens.db.
# Needed when deployed: free hosts wipe their disk on every restart.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---------- Sign-in (web UI) ----------
# Set at least one provider to turn sign-in on; each user then sees only their own history.
# Callback URLs to register: <PUBLIC_URL>/auth/callback/google and <PUBLIC_URL>/auth/callback/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# The app's public address, no trailing slash, e.g. https://your-name-truthlens.hf.space
# PUBLIC_URL=

# LOG_LEVEL=INFO
